/* ═══════════════════════════════════════════════════════════════════════
   BENG'S UNLI LUGAW — POS DESIGN SYSTEM
   Palette  : Toasted Orange #EF820D (dominant) · Chili-Garlic Red #C8102E
              Golden Porridge #FF9F1C · Charcoal #1A1A1A · Crisp White #FFFFFF
   Font     : Plus Jakarta Sans (UI) · JetBrains Mono (numbers)
   ══════════════════════════════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=JetBrains+Mono:wght@400;500;600;700&display=swap');

/* ── CSS Variables ──────────────────────────────────────────────────── */
:root {
  /* ── Brand Core ── */
  --orange:        #EF820D;
  --orange-dark:   #D0700A;
  --orange-dim:    #F4920F;
  --orange-soft:   #FEF0DC;
  --orange-glow:   rgba(239,130,13,0.30);

  --red:           #C8102E;
  --red-dark:      #A80D26;

  --gold:          #FF9F1C;
  --gold-dark:     #E88D12;
  --gold-dim:      #FFB04A;
  --gold-soft:     #FFF4E0;
  --gold-light:    #FFF4E0;

  --charcoal:      #1A1A1A;
  --charcoal-mid:  #2E2E2E;
  --charcoal-light:#444444;

  --white:         #FFFFFF;
  --cream:         #FFF8F0;
  --cream-dark:    #F0E8D8;

  /* ── Semantic aliases for old pages ── */
  --navy:          #1A1A1A;
  --navy-deep:     #0D0D0D;
  --navy-mid:      #2E2E2E;
  --navy-light:    #444444;
  --navy-10:       rgba(26,26,26,0.08);
  --navy-20:       rgba(26,26,26,0.15);

  --ice:           #FFF4E8;
  --ice-dark:      #EDD5B0;
  --mint-dark:     #EDD5B0;

  --flame:         #EF820D;
  --flame-soft:    #FEF0DC;

  --brand-navy:    #1A1A1A;
  --brand-yellow:  #EF820D;
  --brand-yellow-d:#D0700A;
  --brand-mint:    #FFF8F0;
  --card-bg:       #FFFFFF;
  --border:        #E8D5B8;
  --col-navy:      #1A1A1A;
  --col-danger:    #C8102E;
  --danger:        #C8102E;

  /* ── new c- aliases used by smpos components ── */
  --c-gold:        #EF820D;
  --c-gold-dark:   #D0700A;
  --c-gold-dim:    #F4920F;
  --c-gold-soft:   #FEF0DC;
  --c-gold-glow:   rgba(239,130,13,0.30);
  --c-navy:        #1A1A1A;
  --c-navy-deep:   #0D0D0D;
  --c-navy-mid:    #2E2E2E;
  --c-navy-light:  #444444;
  --c-navy-10:     rgba(26,26,26,0.08);
  --c-navy-20:     rgba(26,26,26,0.15);
  --c-ice:         #FFF4E8;
  --c-ice-dark:    #EDD5B0;
  --c-white:       #FFFFFF;

  /* ── Semantic states ── */
  --c-success:     #22c87a;
  --c-success-bg:  #f0fdf4;
  --c-success-bdr: #c6f6d5;
  --c-danger:      #e8435a;
  --c-danger-bg:   #fff0f2;
  --c-danger-bdr:  #fecdd3;
  --c-warning:     #f59c2a;
  --c-warning-bg:  #fffbeb;
  --c-warning-bdr: #fed7aa;
  --c-info:        #3b82f6;
  --c-info-bg:     #eff6ff;
  --c-info-bdr:    #bfdbfe;

  /* ── Text ── */
  --t-main:     #1A1A1A;
  --t-mid:      #4A3A28;
  --t-muted:    #7A6A58;
  --t-light:    #B09880;
  --text-dark:  #1A1A1A;
  --text-main:  #1A1A1A;
  --text-mid:   #4A3A28;
  --text-muted: #7A6A58;
  --text-light: #B09880;

  /* ── Surface ── */
  --s-bg:          #F5ECD8;
  --s-card:        #FFFFFF;
  --s-border:      #E8D5B8;
  --s-border-dark: #D4B88A;
  --shadow-card:   0 2px 8px rgba(26,26,26,0.08);
  --shadow-btn:    0 2px 6px rgba(239,130,13,0.30);

  /* ── Typography ── */
  --font-ui:    'Plus Jakarta Sans', system-ui, sans-serif;
  --font-mono:  'JetBrains Mono', 'Courier New', monospace;

  /* ── Radii ── */
  --r-xs:       6px;  --r-sm:  8px;  --r-md: 12px;
  --r-lg:       16px; --r-xl: 20px;  --r-2xl:28px;
  --radius-sm:  8px;  --radius-md:12px; --radius-lg:16px;
  --radius-card:16px; --radius-pill:50px;

  /* ── Shadows ── */
  --sh-xs:    0 1px 4px rgba(26,26,26,0.06);
  --sh-sm:    0 2px 8px rgba(26,26,26,0.08);
  --sh-md:    0 6px 24px rgba(26,26,26,0.12);
  --sh-lg:    0 16px 48px rgba(26,26,26,0.16);
  --sh-gold:  0 4px 16px rgba(239,130,13,0.40);
  --shadow-sm:  0 2px 8px rgba(26,26,26,0.08);
  --shadow-md:  0 6px 24px rgba(26,26,26,0.12);
  --shadow-lg:  0 16px 48px rgba(26,26,26,0.16);

  /* ── Gradients ── */
  --g-navy:    linear-gradient(135deg, #0D0D0D 0%, #1A1A1A 60%, #2E2E2E 100%);
  --g-gold:    linear-gradient(135deg, #EF820D 0%, #D0700A 100%);
  --g-orange:  linear-gradient(135deg, #EF820D 0%, #D0700A 100%);
  --g-teal:    linear-gradient(135deg, #0EA5A0 0%, #0D8F8A 100%);
  --g-violet:  linear-gradient(135deg, #6C63FF 0%, #4A43D9 100%);
  --g-danger:  linear-gradient(135deg, #C8102E 0%, #A80D26 100%);
  --g-success: linear-gradient(135deg, #10b981 0%, #059669 100%);
  --g-warning: linear-gradient(135deg, #FF9F1C 0%, #E88D12 100%);

  /* ── Layout ── */
  --sidebar-w: 248px;
  --topbar-h:  60px;
  --trans: all 0.2s cubic-bezier(0.4,0,0.2,1);
}

/* ── Reset & Base ───────────────────────────────────────────────────── */
*, *::before, *::after { box-sizing: border-box; }
body {
  font-family: var(--font-ui);
  background: var(--s-bg);
  color: var(--t-main);
  font-size: 14px;
  line-height: 1.5;
  margin: 0;
}

/* ── Layout Shell ───────────────────────────────────────────────────── */
.smpos-shell  { display: flex; min-height: 100vh; }
.smpos-main   { flex: 1; min-width: 0; overflow-y: auto; padding-top: var(--topbar-h); }
.smpos-page   { padding: 28px 32px 48px; }
.main-content { flex: 1; min-width: 0; overflow-y: auto; padding-top: var(--topbar-h); }

/* ════════════════════════════════════════════════════════════════════
   SIDEBAR
   ════════════════════════════════════════════════════════════════════ */
.smpos-sidebar, .sidebar {
  width: var(--sidebar-w);
  min-width: var(--sidebar-w);
  height: 100vh;
  background: var(--g-navy);
  position: sticky;
  top: 0;
  overflow-y: auto;
  overflow-x: hidden;
  flex-shrink: 0;
  box-shadow: 4px 0 28px rgba(0,0,0,0.40);
  display: flex;
  flex-direction: column;
}

.smpos-brand, .sidebar-brand {
  padding: 22px 16px 16px;
  border-bottom: 1px solid rgba(239,130,13,0.20);
  text-align: center;
  flex-shrink: 0;
}
.smpos-brand-logo, .sidebar-logo {
  width: 52px; height: 52px;
  background: var(--g-orange);
  border-radius: 14px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.5rem; color: #fff;
  margin: 0 auto 8px;
  box-shadow: var(--sh-gold);
  overflow: hidden;
}
.smpos-brand-logo img, .sidebar-logo img {
  width: 100%; height: 100%; object-fit: cover; display: none; border-radius: 12px;
}
.smpos-brand-name, .brand-name {
  font-size: 1.05rem; font-weight: 800; color: #fff; letter-spacing: -0.3px;
}
.smpos-brand-sub, .brand-sub {
  font-size: 9px; color: rgba(255,255,255,0.35); letter-spacing: 2px; text-transform: uppercase;
}

.smpos-nav { flex: 1; padding: 8px 0 20px; }
.smpos-nav-label, .nav-section-label {
  font-size: 9px; text-transform: uppercase; letter-spacing: 2px;
  color: rgba(239,130,13,0.60); padding: 16px 20px 5px;
  font-weight: 700; display: block;
}

.smpos-nav-link, .sidebar a {
  color: rgba(255,255,255,0.65);
  text-decoration: none;
  display: flex; align-items: center; gap: 10px;
  padding: 9px 16px;
  font-size: 13px; font-weight: 500;
  margin: 1px 10px;
  border-radius: 10px;
  transition: var(--trans);
}
.smpos-nav-link:hover, .sidebar a:hover {
  background: rgba(239,130,13,0.15);
  color: var(--orange);
  padding-left: 20px;
}
.smpos-nav-link.active, .sidebar a.active {
  background: var(--g-orange);
  color: #fff;
  box-shadow: var(--sh-gold);
  font-weight: 700;
}
.smpos-nav-link i, .sidebar a i {
  font-size: 1rem; width: 20px; text-align: center; flex-shrink: 0;
}

.smpos-sidebar::-webkit-scrollbar, .sidebar::-webkit-scrollbar { width: 4px; }
.smpos-sidebar::-webkit-scrollbar-thumb, .sidebar::-webkit-scrollbar-thumb {
  background: rgba(239,130,13,0.30); border-radius: 4px;
}

/* ════════════════════════════════════════════════════════════════════
   TOPBAR
   ════════════════════════════════════════════════════════════════════ */
.smpos-topbar, .topbar {
  background: var(--white);
  border-bottom: 2.5px solid var(--orange);
  padding: 0 24px;
  height: var(--topbar-h);
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  box-shadow: 0 2px 12px rgba(239,130,13,0.15);
  position: fixed; top: 0; left: var(--sidebar-w); right: 0; z-index: 200;
}
.smpos-topbar-left { display: flex; align-items: center; gap: 12px; min-width: 0; }
.smpos-topbar-icon {
  width: 38px; height: 38px; border-radius: 10px;
  background: var(--g-orange);
  display: flex; align-items: center; justify-content: center;
  color: #fff; font-size: 1rem; flex-shrink: 0;
}
.smpos-topbar-text  { display: flex; flex-direction: column; justify-content: center; line-height: 1.2; min-width: 0; }
.smpos-topbar-title { font-size: 0.95rem; font-weight: 800; color: var(--charcoal); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.smpos-topbar-sub   { font-size: 0.7rem; color: var(--t-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.smpos-topbar-right { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }

.smpos-user-badge, .user-chip {
  display: flex; align-items: center; gap: 8px;
  background: var(--s-bg); padding: 6px 14px 6px 10px;
  border-radius: 50px; border: 1.5px solid var(--s-border);
}
.smpos-user-badge-icon { font-size: 1.3rem; color: var(--charcoal); flex-shrink: 0; }
.smpos-user-name, .uname {
  font-size: 13px; font-weight: 600; color: var(--charcoal);
  max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.smpos-role-pill, .role-tag {
  background: var(--g-orange); color: #fff;
  padding: 2px 10px; border-radius: 12px;
  font-size: 10px; font-weight: 700; letter-spacing: 0.5px; white-space: nowrap;
}

/* ════════════════════════════════════════════════════════════════════
   TYPOGRAPHY
   ════════════════════════════════════════════════════════════════════ */
.smpos-page-title {
  font-size: 1.2rem; font-weight: 800; color: var(--charcoal);
  display: flex; align-items: center; gap: 8px; letter-spacing: -0.2px;
}
.smpos-page-title::before {
  content: ''; display: inline-block; width: 10px; height: 10px;
  background: var(--orange); border-radius: 50%; flex-shrink: 0;
}
.smpos-section-label {
  font-size: 10px; font-weight: 700; letter-spacing: 1.2px;
  text-transform: uppercase; color: var(--t-muted);
  display: flex; align-items: center; gap: 8px; margin-bottom: 12px;
}
.smpos-section-label::after { content: ''; flex: 1; height: 1px; background: var(--s-border); }

/* ════════════════════════════════════════════════════════════════════
   CARDS
   ════════════════════════════════════════════════════════════════════ */
.smpos-card {
  background: var(--white); border-radius: var(--r-lg);
  border: 1.5px solid var(--s-border); box-shadow: var(--sh-sm); overflow: hidden;
}
.smpos-card-header {
  padding: 16px 20px; border-bottom: 1.5px solid var(--s-border);
  display: flex; align-items: center; justify-content: space-between; gap: 10px;
  background: #FFF8F0;
}
.smpos-card-title {
  font-size: 14px; font-weight: 700; color: var(--t-main);
  display: flex; align-items: center; gap: 8px;
}
.smpos-card-icon {
  width: 30px; height: 30px; border-radius: 8px;
  background: var(--orange); color: #fff;
  display: flex; align-items: center; justify-content: center;
  font-size: 14px; flex-shrink: 0;
}
.smpos-card-body { padding: 20px; }

/* Stat cards */
.smpos-stat {
  border-radius: var(--r-lg); padding: 22px;
  position: relative; overflow: hidden;
  box-shadow: var(--sh-md); transition: var(--trans);
  display: flex; flex-direction: column; justify-content: space-between;
  min-height: 116px;
}
.smpos-stat:hover { transform: translateY(-2px); box-shadow: var(--sh-lg); }
.smpos-stat::before {
  content: ''; position: absolute; bottom: -18px; right: -18px;
  width: 80px; height: 80px; border-radius: 50%;
  background: rgba(255,255,255,0.08); pointer-events: none;
}
.smpos-stat-icon {
  width: 38px; height: 38px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.1rem; margin-bottom: 14px; flex-shrink: 0;
}
.smpos-stat-val { font-size: 1.65rem; font-weight: 800; line-height: 1; letter-spacing: -0.5px; font-family: var(--font-mono); }
.smpos-stat-lbl { font-size: 11px; font-weight: 600; margin-top: 4px; opacity: 0.72; letter-spacing: 0.5px; text-transform: uppercase; }

.smpos-stat-navy   { background: linear-gradient(135deg,#0D0D0D 0%,#1A1A1A 60%,#2E2E2E 100%); color:#fff; }
.smpos-stat-navy   .smpos-stat-icon { background: rgba(239,130,13,0.20); color: var(--orange); }
.smpos-stat-gold   { background: var(--g-orange); color: #fff; }
.smpos-stat-gold   .smpos-stat-icon { background: rgba(255,255,255,0.20); color: #fff; }
.smpos-stat-gold   .smpos-stat-lbl  { opacity: 0.75; }
.smpos-stat-teal   { background: var(--g-teal); color: #fff; }
.smpos-stat-teal   .smpos-stat-icon { background: rgba(255,255,255,0.2); color: #fff; }
.smpos-stat-violet { background: var(--g-violet); color: #fff; }
.smpos-stat-violet .smpos-stat-icon { background: rgba(255,255,255,0.15); color: #fff; }
.smpos-stat-danger { background: var(--g-danger); color: #fff; }
.smpos-stat-danger .smpos-stat-icon { background: rgba(255,255,255,0.15); color: #fff; }
.smpos-stat-success{ background: var(--g-success); color: #fff; }
.smpos-stat-success .smpos-stat-icon { background: rgba(255,255,255,0.15); color: #fff; }

/* Flat stat tile */
.smpos-tile {
  background: var(--white); border-radius: var(--r-lg);
  padding: 18px 20px; border: 1.5px solid var(--s-border);
  box-shadow: var(--sh-sm); display: flex; align-items: center; gap: 14px;
  transition: var(--trans);
}
.smpos-tile:hover { box-shadow: var(--sh-md); transform: translateY(-2px); }
.smpos-tile-icon {
  width: 48px; height: 48px; border-radius: 13px;
  display: flex; align-items: center; justify-content: center;
  font-size: 1.35rem; flex-shrink: 0;
}
.smpos-tile-icon-navy   { background: var(--charcoal);    color: var(--orange); }
.smpos-tile-icon-gold   { background: var(--orange-soft); color: var(--orange-dark); }
.smpos-tile-icon-ice    { background: var(--ice-dark);    color: var(--charcoal-light); }
.smpos-tile-icon-green  { background: #d0f5e8;            color: #0d8f56; }
.smpos-tile-icon-red    { background: var(--c-danger-bg); color: var(--c-danger); }
.smpos-tile-val { font-size: 1.35rem; font-weight: 900; color: var(--t-main); line-height: 1.1; font-family: var(--font-mono); }
.smpos-tile-lbl { font-size: 11.5px; color: var(--t-muted); font-weight: 600; margin-top: 2px; }

/* ════════════════════════════════════════════════════════════════════
   BUTTONS
   ════════════════════════════════════════════════════════════════════ */
.smpos-btn {
  display: inline-flex; align-items: center; gap: 6px;
  font-family: var(--font-ui); font-weight: 700;
  border: none; border-radius: var(--r-sm);
  padding: 9px 18px; font-size: 13px;
  cursor: pointer; transition: var(--trans);
  text-decoration: none; line-height: 1; white-space: nowrap;
}
.smpos-btn:disabled { opacity: 0.55; cursor: not-allowed; }

.smpos-btn-primary { background: var(--charcoal); color: #fff; box-shadow: 0 3px 10px rgba(26,26,26,0.25); }
.smpos-btn-primary:hover { background: var(--charcoal-mid); color: #fff; transform: translateY(-1px); }

.smpos-btn-accent { background: var(--orange); color: #fff; box-shadow: var(--sh-gold); }
.smpos-btn-accent:hover { background: var(--orange-dark); color: #fff; transform: translateY(-1px); }

.smpos-btn-ghost { background: var(--white); color: var(--t-mid); border: 1.5px solid var(--s-border); }
.smpos-btn-ghost:hover { border-color: var(--orange); color: var(--orange); }

.smpos-btn-danger  { background: var(--g-danger); color: #fff; }
.smpos-btn-danger:hover  { opacity: 0.9; transform: translateY(-1px); }
.smpos-btn-success { background: var(--g-success); color: #fff; }
.smpos-btn-success:hover { opacity: 0.9; transform: translateY(-1px); }

.smpos-btn-icon {
  width: 32px; height: 32px; border-radius: var(--r-sm);
  border: none; cursor: pointer;
  display: inline-flex; align-items: center; justify-content: center;
  font-size: 0.85rem; transition: var(--trans); padding: 0;
}
.smpos-btn-icon:hover        { transform: scale(1.1); }
.smpos-btn-icon-edit         { background: rgba(239,130,13,0.12); color: var(--orange-dark); }
.smpos-btn-icon-del          { background: var(--c-danger-bg); color: var(--c-danger); }
.smpos-btn-icon-view         { background: var(--c-info-bg);   color: var(--c-info); }
.smpos-btn-icon-success      { background: var(--c-success-bg); color: var(--c-success); }

/* ════════════════════════════════════════════════════════════════════
   TABLES
   ════════════════════════════════════════════════════════════════════ */
.smpos-table-wrap { overflow-x: auto; }
.smpos-table { width: 100%; border-collapse: collapse; }
.smpos-table thead th {
  background: var(--charcoal); color: var(--orange);
  font-size: 11px; font-weight: 700; letter-spacing: 0.6px; text-transform: uppercase;
  padding: 12px 14px; border: none; white-space: nowrap;
}
.smpos-table tbody tr { transition: background 0.12s; }
.smpos-table tbody tr:nth-child(even) { background: rgba(255,159,28,0.06); }
.smpos-table tbody tr:hover           { background: rgba(239,130,13,0.10) !important; }
.smpos-table tbody td {
  padding: 11px 14px; border-bottom: 1px solid rgba(26,26,26,0.06);
  vertical-align: middle; color: var(--t-main); font-size: 13px;
}
.smpos-table tbody tr:last-child td { border-bottom: none; }

/* DataTables overrides */
div.dataTables_wrapper div.dataTables_filter label,
div.dataTables_wrapper div.dataTables_length label { color: var(--t-muted); font-size: 12.5px; }
div.dataTables_wrapper div.dataTables_filter input,
div.dataTables_wrapper div.dataTables_length select {
  border: 1.5px solid var(--s-border); border-radius: var(--r-sm);
  padding: 5px 10px; font-size: 12.5px; color: var(--t-main);
  background: var(--white); outline: none; font-family: var(--font-ui);
}
div.dataTables_wrapper div.dataTables_filter input:focus { border-color: var(--orange); }
div.dataTables_wrapper div.dataTables_paginate .paginate_button { border-radius: var(--r-sm) !important; font-size: 12px; }
div.dataTables_wrapper div.dataTables_paginate .paginate_button.current,
div.dataTables_wrapper div.dataTables_paginate .paginate_button.current:hover {
  background: var(--orange) !important; color: #fff !important; border-color: var(--orange) !important;
}
div.dataTables_wrapper .dataTables_info { color: var(--t-muted); font-size: 12px; }

/* ════════════════════════════════════════════════════════════════════
   FORMS & INPUTS
   ════════════════════════════════════════════════════════════════════ */
.smpos-form-label {
  font-size: 12px; font-weight: 700; color: var(--t-mid); margin-bottom: 5px; display: block;
}
.smpos-form-control, .form-control, .form-select {
  font-family: var(--font-ui);
  border: 1.5px solid var(--s-border); border-radius: var(--r-sm);
  padding: 9px 12px; font-size: 13.5px;
  color: var(--t-main); background: var(--white);
  transition: border-color 0.2s, box-shadow 0.2s; width: 100%;
}
.smpos-form-control:focus, .form-control:focus, .form-select:focus {
  outline: none; border-color: var(--orange);
  box-shadow: 0 0 0 3px rgba(239,130,13,0.15); background: var(--white);
}
.smpos-form-control::placeholder { color: var(--t-light); }

/* ════════════════════════════════════════════════════════════════════
   BADGES & PILLS
   ════════════════════════════════════════════════════════════════════ */
.smpos-badge {
  display: inline-block; padding: 3px 10px;
  border-radius: 50px; font-size: 11px; font-weight: 700;
  letter-spacing: 0.4px; text-transform: uppercase;
}
.smpos-badge-active   { background: #dcfce7; color: #166534; }
.smpos-badge-inactive { background: #fee2e2; color: #991b1b; }
.smpos-badge-low      { background: #fef3c7; color: #92400e; }
.smpos-badge-pending  { background: #fef3c7; color: #92400e; }
.smpos-badge-received { background: #dcfce7; color: #166534; }
.smpos-badge-navy     { background: var(--charcoal); color: var(--orange); }
.smpos-badge-gold     { background: var(--orange); color: #fff; }
.smpos-badge-method   { background: #FFF0DC; color: var(--orange-dark); }

.smpos-avatar {
  width: 34px; height: 34px; border-radius: 50%;
  background: var(--g-orange); color: #fff;
  font-weight: 800; font-size: 0.8rem;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; text-transform: uppercase;
}

/* ════════════════════════════════════════════════════════════════════
   ALERTS
   ════════════════════════════════════════════════════════════════════ */
.smpos-alert {
  display: flex; align-items: center; gap: 12px;
  padding: 11px 18px; border-radius: var(--r-sm);
  font-size: 13.5px; font-weight: 500;
  margin-bottom: 10px; border-left: 4px solid;
}
.smpos-alert-action {
  margin-left: auto; padding: 4px 14px;
  border-radius: var(--r-xs); font-size: 12px; font-weight: 700;
  text-decoration: none; white-space: nowrap; border: none; cursor: pointer; transition: var(--trans);
}
.smpos-alert-danger  { background: var(--c-danger-bg);  border-color: var(--c-danger); color: #7f1d1d; }
.smpos-alert-danger  .smpos-alert-action { background: var(--c-danger); color: #fff; }
.smpos-alert-warning { background: var(--c-warning-bg); border-color: var(--c-warning); color: #78350f; }
.smpos-alert-warning .smpos-alert-action { background: var(--orange); color: #fff; }
.smpos-alert-info    { background: var(--c-info-bg);    border-color: var(--c-info); color: #1e40af; }
.smpos-alert-info    .smpos-alert-action { background: var(--c-info); color: #fff; }
.smpos-alert-success { background: var(--c-success-bg); border-color: var(--c-success); color: #14532d; }
.smpos-alert-success .smpos-alert-action { background: var(--c-success); color: #fff; }

.alert-warning { background: var(--c-warning-bg); border-left: 4px solid var(--c-warning); border-top: none; border-right: none; border-bottom: none; color: #78350f; }
.alert-danger  { background: var(--c-danger-bg);  border-left: 4px solid var(--c-danger);  border-top: none; border-right: none; border-bottom: none; color: #7f1d1d; }
.alert-success { background: var(--c-success-bg); border-left: 4px solid var(--c-success); border-top: none; border-right: none; border-bottom: none; color: #14532d; }
.alert-info    { background: var(--c-info-bg);    border-left: 4px solid var(--c-info);    border-top: none; border-right: none; border-bottom: none; color: #1e40af; }
.alert { border-radius: var(--r-sm); font-size: 13.5px; }

/* ════════════════════════════════════════════════════════════════════
   MODALS
   ════════════════════════════════════════════════════════════════════ */
.modal-content {
  border: none; border-radius: var(--r-xl) !important;
  box-shadow: var(--sh-lg); overflow: hidden; font-family: var(--font-ui);
}
.smpos-modal-header {
  background: var(--charcoal); color: #fff; padding: 18px 24px;
  display: flex; align-items: center; justify-content: space-between;
}
.smpos-modal-header .modal-title { font-size: 1rem; font-weight: 700; margin: 0; display: flex; align-items: center; gap: 8px; }
.smpos-modal-header .btn-close    { filter: brightness(0) invert(1); opacity: 0.7; }
.smpos-modal-header-danger        { background: var(--g-danger); }
.smpos-modal-header-success       { background: var(--g-success); }
.smpos-modal-header-warning       { background: var(--g-orange); }
.smpos-modal-header-gold          { background: var(--g-orange); color: #fff; }
.smpos-modal-header-gold .btn-close { filter: brightness(0) invert(1); opacity: 0.7; }
.modal-header.bg-primary  { background: var(--charcoal) !important; }
.modal-header.bg-danger   { background: var(--g-danger)  !important; border: none; }
.modal-header.bg-success  { background: var(--g-success) !important; border: none; }
.modal-header.bg-warning  { background: var(--g-orange)  !important; border: none; }

/* ════════════════════════════════════════════════════════════════════
   FILTERS / SEARCH
   ════════════════════════════════════════════════════════════════════ */
.smpos-filter-card {
  background: var(--white); border-radius: var(--r-lg);
  border: 1.5px solid var(--s-border); box-shadow: var(--sh-sm);
  padding: 16px 20px; margin-bottom: 18px;
}
.smpos-filter-title {
  font-size: 10px; font-weight: 800; letter-spacing: 1.2px;
  color: var(--t-muted); text-transform: uppercase; margin-bottom: 12px;
  display: flex; align-items: center; gap: 6px;
}
.smpos-search-wrap { position: relative; }
.smpos-search-wrap i {
  position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
  color: var(--t-muted); font-size: 1rem; pointer-events: none;
}
.smpos-search-wrap input {
  padding-left: 40px; border: 1.5px solid var(--s-border); border-radius: var(--r-sm);
  height: 38px; font-size: 13.5px; color: var(--t-main);
  background: var(--s-bg); width: 100%; font-family: var(--font-ui); transition: var(--trans);
}
.smpos-search-wrap input:focus {
  outline: none; border-color: var(--orange);
  background: var(--white); box-shadow: 0 0 0 3px rgba(239,130,13,0.12);
}

.smpos-cat-strip { display: flex; gap: 6px; overflow-x: auto; scrollbar-width: none; }
.smpos-cat-strip::-webkit-scrollbar { display: none; }
.smpos-cat-pill {
  white-space: nowrap; padding: 5px 14px; border-radius: 50px;
  border: 1.5px solid var(--s-border); background: var(--white);
  font-size: 12px; font-weight: 700; color: var(--t-mid);
  cursor: pointer; transition: var(--trans); flex-shrink: 0;
}
.smpos-cat-pill:hover  { border-color: var(--orange); color: var(--orange); }
.smpos-cat-pill.active { background: var(--charcoal); color: var(--orange); border-color: var(--charcoal); box-shadow: 0 3px 10px rgba(26,26,26,0.25); }

/* ════════════════════════════════════════════════════════════════════
   BOOTSTRAP OVERRIDES
   ════════════════════════════════════════════════════════════════════ */
.btn-primary { background: var(--charcoal) !important; border-color: var(--charcoal) !important; color: var(--orange) !important; font-weight: 700 !important; }
.btn-primary:hover { background: var(--charcoal-mid) !important; border-color: var(--charcoal-mid) !important; color: var(--orange) !important; }
.btn-warning  { background: var(--g-orange)  !important; border: none !important; color: #fff !important; font-weight: 700 !important; }
.btn-danger   { background: var(--g-danger)  !important; border: none !important; color: #fff !important; font-weight: 700 !important; }
.btn-success  { background: var(--g-success) !important; border: none !important; color: #fff !important; font-weight: 700 !important; }
.btn-secondary { background: #5a6070 !important; border-color: #5a6070 !important; font-weight: 700 !important; }

.btn-outline-primary { color: var(--charcoal) !important; border-color: var(--charcoal) !important; }
.btn-outline-primary:hover { background: var(--charcoal) !important; color: var(--orange) !important; }
.btn-outline-danger  { color: var(--red) !important; border-color: var(--red) !important; }
.btn-outline-danger:hover  { background: var(--red) !important; color: #fff !important; }
.btn-outline-success { color: #059669 !important; border-color: #059669 !important; }
.btn-outline-success:hover { background: #059669 !important; color: #fff !important; }
.btn-outline-warning { color: var(--orange-dark) !important; border-color: var(--orange) !important; }
.btn-outline-warning:hover { background: var(--orange) !important; color: #fff !important; }

.badge.bg-primary   { background: var(--charcoal) !important; color: var(--orange) !important; }
.badge.bg-success   { background: var(--g-success) !important; }
.badge.bg-danger    { background: var(--g-danger)  !important; }
.badge.bg-warning   { background: var(--g-orange)  !important; color: #fff !important; }
.badge.bg-secondary { background: #5a6070 !important; }

.card { border-radius: var(--r-lg) !important; border: 1.5px solid var(--s-border) !important; box-shadow: var(--sh-sm) !important; }
.table th { font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; }
.table td { font-size: 13px; vertical-align: middle; }

/* ════════════════════════════════════════════════════════════════════
   UTILITY CLASSES
   ════════════════════════════════════════════════════════════════════ */
.font-mono    { font-family: var(--font-mono) !important; }
.text-navy    { color: var(--charcoal) !important; }
.text-gold    { color: var(--orange) !important; }
.text-muted-sm { font-size: 11px; color: var(--t-muted); }
.bg-ice       { background: var(--ice) !important; }
.bg-navy      { background: var(--charcoal) !important; }
.bg-gold      { background: var(--orange) !important; }
.border-navy  { border-color: var(--charcoal) !important; }
.smpos-section-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 20px; flex-wrap: wrap; gap: 10px;
}

/* ════════════════════════════════════════════════════════════════════
   PRINT
   ════════════════════════════════════════════════════════════════════ */
@media print {
  .smpos-sidebar, .sidebar, .smpos-topbar, .topbar, .no-print { display: none !important; }
  .smpos-main, .main-content { margin: 0 !important; padding-top: 0 !important; }
}

/* ════════════════════════════════════════════════════════════════════
   RESPONSIVE
   ════════════════════════════════════════════════════════════════════ */
@media (max-width: 768px) {
  .smpos-topbar, .topbar { left: 0; padding: 0 14px; }
  .smpos-sidebar, .sidebar { display: none; }
  .smpos-page { padding: 16px; }
  .smpos-topbar-sub, .smpos-user-name { display: none; }
}

/* ════════════════════════════════════════════════════════════════════
   SWEETALERT2
   ════════════════════════════════════════════════════════════════════ */
.swal2-confirm { background: var(--orange) !important; color: #fff !important; }
.swal2-popup   { border-radius: var(--r-xl) !important; font-family: var(--font-ui) !important; }

/* ════════════════════════════════════════════════════════════════════
   MODAL HEADER ALIASES
   ════════════════════════════════════════════════════════════════════ */
.modal-header-ev, .modal-header-brand {
  background: var(--charcoal); color: #fff;
  padding: 18px 24px;
  display: flex; align-items: center; justify-content: space-between;
  border: none;
}
.modal-header-ev .modal-title, .modal-header-brand .modal-title {
  font-size: 1rem; font-weight: 700; margin: 0;
  display: flex; align-items: center; gap: 8px; color: #fff;
}
.modal-header-ev .modal-title i { color: var(--orange); }
.modal-header-ev .btn-close, .modal-header-brand .btn-close { filter: brightness(0) invert(1); opacity: .7; }

.modal-header-danger {
  background: var(--g-danger); color: #fff; padding: 18px 24px;
  display: flex; align-items: center; justify-content: space-between; border: none;
}
.modal-header-danger .modal-title { font-size:1rem; font-weight:700; margin:0; }
.modal-header-danger .btn-close   { filter: brightness(0) invert(1); opacity:.7; }

.modal-header-success {
  background: linear-gradient(135deg,#10B981,#059669); color: #fff; padding: 18px 24px;
  display: flex; align-items: center; justify-content: space-between; border: none;
}
.modal-header-success .modal-title { font-size:1rem; font-weight:700; margin:0; }
.modal-header-success .btn-close   { filter: brightness(0) invert(1); opacity:.7; }

.modal-header-warning {
  background: var(--g-orange); color: #fff; padding: 18px 24px;
  display: flex; align-items: center; justify-content: space-between; border: none;
}
.modal-header-warning .modal-title { font-size:1rem; font-weight:700; margin:0; }
.modal-header-warning .btn-close   { filter: brightness(0) invert(1); opacity:.7; }
/* ════════════════════════════════════════════════════════════════════
   EV-TOPBAR ALIASES  (topbar.php was using these class names)
   ════════════════════════════════════════════════════════════════════ */
.ev-topbar          { background: var(--white); border-bottom: 2.5px solid var(--orange); padding: 0 24px; height: var(--topbar-h); display: flex; align-items: center; justify-content: space-between; gap: 12px; box-shadow: 0 2px 12px rgba(239,130,13,0.15); position: fixed; top: 0; left: var(--sidebar-w); right: 0; z-index: 200; }
.ev-topbar-left     { display: flex; align-items: center; gap: 12px; min-width: 0; }
.ev-topbar-icon     { width: 38px; height: 38px; border-radius: 10px; background: var(--g-orange); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 1rem; flex-shrink: 0; }
.ev-topbar-text     { display: flex; flex-direction: column; justify-content: center; line-height: 1.2; min-width: 0; }
.ev-topbar-title    { font-size: 0.95rem; font-weight: 800; color: var(--charcoal); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ev-topbar-sub      { font-size: 0.7rem; color: var(--t-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ev-topbar-right    { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
.ev-topbar-actions  { display: flex; align-items: center; gap: 8px; }
.ev-user-badge      { display: flex; align-items: center; gap: 8px; background: var(--s-bg); padding: 6px 14px 6px 10px; border-radius: 50px; border: 1.5px solid var(--s-border); }
.ev-user-icon       { font-size: 1.3rem; color: var(--charcoal); flex-shrink: 0; }
.ev-user-info       { display: flex; flex-direction: column; line-height: 1.2; }
.ev-user-name       { font-size: 13px; font-weight: 600; color: var(--charcoal); max-width: 140px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.ev-role-pill       { background: var(--g-orange); color: #fff; padding: 2px 10px; border-radius: 12px; font-size: 10px; font-weight: 700; letter-spacing: 0.5px; white-space: nowrap; }

/* smpos-user-info alias (used by new topbar.php) */
.smpos-user-info    { display: flex; flex-direction: column; line-height: 1.2; }

/* ════════════════════════════════════════════════════════════════════
   FOOTER
   ════════════════════════════════════════════════════════════════════ */
.smpos-footer {
  background: var(--charcoal);
  border-top: 3px solid var(--orange);
  padding: 0 28px;
  height: 48px;
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.smpos-footer-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  gap: 12px;
}
.smpos-footer-brand {
  display: flex;
  align-items: center;
  gap: 8px;
}
.smpos-footer-icon {
  color: var(--orange);
  font-size: 1rem;
}
.smpos-footer-name {
  font-size: 13px;
  font-weight: 700;
  color: #fff;
  letter-spacing: 0.2px;
}
.smpos-footer-center {
  flex: 1;
  text-align: center;
}
.smpos-footer-tagline {
  font-size: 11px;
  color: rgba(255,255,255,0.45);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  font-weight: 600;
}
.smpos-footer-right {}
.smpos-footer-copy {
  font-size: 11px;
  color: rgba(255,255,255,0.35);
}

/* make main-content a flex column so footer sticks to bottom */
.main-content {
  display: flex !important;
  flex-direction: column !important;
}
.main-content > *:not(.smpos-footer):not(.smpos-topbar):not(.no-print) {
  flex: 1 0 auto;
}
.smpos-footer { flex-shrink: 0; }

/* ── Print: hide footer ── */
@media print {
  .smpos-footer { display: none !important; }
}
/* ── Responsive: full-width topbar on mobile ── */
@media (max-width: 768px) {
  .ev-topbar { left: 0; padding: 0 14px; }
  .ev-topbar-sub, .ev-user-name { display: none; }
}
